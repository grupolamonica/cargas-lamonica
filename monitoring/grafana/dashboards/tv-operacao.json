        "h": 6,
        "w": 4,
        "x": 20,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lmc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(node_filesystem_avail_bytes{job=\"supabase\",mountpoint=\"/data\"}) / sum(node_filesystem_size_bytes{job=\"supabase\",mountpoint=\"/data\"}))",
