{
  "__comment": "TV — Operação Lamonica. Importar no Grafana da empresa após criar os datasources com UIDs lmc-prometheus e lmc-postgres (ver monitoring/README.md). Painéis do job 'supabase' podem precisar de ajuste de nome de métrica após o 1º scrape.",
  "uid": "tv-operacao",
  "title": "TV — Operação Lamonica",
  "tags": [
    "lamonica",
    "tv"
  ],
  "timezone": "America/Sao_Paulo",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Site (cargas.grupolamonica.com)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lmc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"blackbox-site\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA DO AR",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "NO AR",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "SEM DADO"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
