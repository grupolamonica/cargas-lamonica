    {
      "id": 34,
      "type": "barchart",
      "title": "Cargas por status",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lmc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status, total FROM kpi.cargas_status_atual WHERE status IN ('OPEN','RESERVED','BOOKED','COMPLETED') ORDER BY CASE status WHEN 'OPEN' THEN 1 WHEN 'RESERVED' THEN 2 WHEN 'BOOKED' THEN 3 ELSE 4 END;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Funil de candidaturas — últimos 7 dias",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lmc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dia::timestamp AS \"time\", pre_registered AS \"candidaturas\", queued AS \"na fila\", approved AS \"aprovados\" FROM kpi.leads_funil_dia WHERE dia >= (now() AT TIME ZONE 'America/Sao_Paulo')::date - 6 ORDER BY dia;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
