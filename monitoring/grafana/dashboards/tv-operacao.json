{
  "__comment": "TV — Operação Lamonica. Importar no Grafana da empresa após criar os datasources com UIDs lmc-prometheus e lmc-postgres (ver monitoring/README.md). Painéis do job 'supabase' podem precisar de ajuste de nome de métrica após o 1º scrape.",
  "uid": "tv-operacao",
  "title": "TV — Operação Lamonica",
  "tags": ["lamonica", "tv"],
  "timezone": "America/Sao_Paulo",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Site (cargas.grupolamonica.com)",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"blackbox-site\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "FORA DO AR", "color": "red", "index": 1 },
                "1": { "text": "NO AR", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "noValue": "SEM DADO"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"lamonica-backend\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "FORA", "color": "red", "index": 1 },
                "1": { "text": "OK", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "noValue": "SEM DADO"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bots (Angellira · SPX · Unificada · OCR)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-bots\"}",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "FORA", "color": "red", "index": 1 },
                "1": { "text": "OK", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "noValue": "SEM DADO"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime do backend",
      "description": "Se zerar, o container reiniciou.",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "lamonica_process_uptime_seconds", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "yellow", "value": null }, { "color": "green", "value": 3600 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Erros 5xx agora",
      "description": "% das requisições nos últimos 5 min.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m])) or vector(0)) / sum(rate(traefik_service_requests_total[5m]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requisições/s (Traefik)",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "% erros 5xx",
      "gridPos": { "h": 8, "w": 7, "x": 10, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m])) or vector(0)) / sum(rate(traefik_service_requests_total[5m]))",
          "legendFormat": "% 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "fillOpacity": 25, "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latência p95",
      "gridPos": { "h": 8, "w": 7, "x": 17, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(traefik_service_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Fila do pool pg (waiting)",
      "description": "Requisições esperando conexão com o banco. >0 sustentado = pool saturado.",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "lamonica_pg_pool_waiting", "instant": false }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Pool pg (conexões vs teto)",
      "gridPos": { "h": 8, "w": 6, "x": 4, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "lamonica_pg_pool_total", "legendFormat": "em uso" },
        { "refId": "B", "expr": "lamonica_pg_pool_max", "legendFormat": "teto" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "teto" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Memória do backend (RSS)",
      "gridPos": { "h": 8, "w": 6, "x": 10, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "lamonica_process_memory_rss_bytes", "legendFormat": "RSS" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Supabase — conexões",
      "description": "Ajustar nome da métrica após o 1º scrape do job supabase.",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_num_backends{job=\"supabase\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 40 }, { "color": "red", "value": 55 } ] },
          "noValue": "AJUSTAR QUERY"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 24,
      "type": "gauge",
      "title": "Supabase — disco usado",
      "description": "Ajustar nome/labels da métrica após o 1º scrape do job supabase.",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "lmc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(node_filesystem_avail_bytes{job=\"supabase\",mountpoint=\"/data\"}) / sum(node_filesystem_size_bytes{job=\"supabase\",mountpoint=\"/data\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 } ] },
          "noValue": "AJUSTAR QUERY"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Cadastros pendentes",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 21 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(total, 0) AS pendentes FROM kpi.cadastros_status_atual WHERE status = 'pendente' UNION ALL SELECT 0 WHERE NOT EXISTS (SELECT 1 FROM kpi.cadastros_status_atual WHERE status = 'pendente') LIMIT 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Candidaturas hoje",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 21 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT pre_registered FROM kpi.leads_funil_dia WHERE dia = (now() AT TIME ZONE 'America/Sao_Paulo')::date), 0) AS candidaturas;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Aprovados hoje (leads)",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 21 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT approved FROM kpi.leads_funil_dia WHERE dia = (now() AT TIME ZONE 'America/Sao_Paulo')::date), 0) AS aprovados;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Automação com ERRO (24h)",
      "description": "Jobs Angellira/SPX/Unificada em ERROR nas últimas 24h.",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 21 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(erros), 0) AS erros_24h FROM kpi.automacao_erros_24h;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 34,
      "type": "barchart",
      "title": "Cargas por status",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status, total FROM kpi.cargas_status_atual WHERE status IN ('OPEN','RESERVED','BOOKED','COMPLETED') ORDER BY CASE status WHEN 'OPEN' THEN 1 WHEN 'RESERVED' THEN 2 WHEN 'BOOKED' THEN 3 ELSE 4 END;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "", "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Funil de candidaturas — últimos 7 dias",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 27 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dia::timestamp AS \"time\", pre_registered AS \"candidaturas\", queued AS \"na fila\", approved AS \"aprovados\" FROM kpi.leads_funil_dia WHERE dia >= (now() AT TIME ZONE 'America/Sao_Paulo')::date - 6 ORDER BY dia;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "always", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 36,
      "type": "stat",
      "title": "Claims hoje",
      "description": "Candidaturas a cargas registradas hoje (load_claims).",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 27 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT claims_created FROM kpi.claims_dia WHERE dia = (now() AT TIME ZONE 'America/Sao_Paulo')::date), 0) AS claims_hoje;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Confirmadas hoje",
      "description": "Claims confirmadas hoje (CLAIM_CONFIRMED).",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 27 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "lmc-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT claims_confirmed FROM kpi.claims_dia WHERE dia = (now() AT TIME ZONE 'America/Sao_Paulo')::date), 0) AS confirmadas_hoje;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    }
  ]
}
