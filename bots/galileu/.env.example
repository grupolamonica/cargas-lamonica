# ── Coletor Nestlé (Projeto Galileu adaptado) ──────────────────────────────────
# Copie para .env (NÃO versionar) OU injete via backend.env no docker-compose.

# Galileo (TMS da Nestlé) — ORIGEM. Obrigatórios p/ o coletor rodar.
GALILEU_URL=
GALILEU_USER=
GALILEU_PASSWORD=

# Supabase de DESTINO = projeto do Cargas Lamônica (onde a Programação lê).
# Se não setar, cai para SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY do backend.
NESTLE_SUPABASE_URL=
NESTLE_SUPABASE_SERVICE_ROLE_KEY=

# Cadência do loop de coleta, em segundos (default 60).
NESTLE_COLETA_INTERVAL_SEC=60

# ── Guarda anti no-op dos upserts (perf: WAL/bloat/egresso) ───────────────────
# O coletor mantém em processo um espelho do conteúdo das tabelas e só grava a linha
# nova ou que realmente mudou. Kill-switch: false volta ao comportamento antigo
# (reescreve todas as linhas a cada ciclo).
NESTLE_UPSERT_GUARD_ENABLED=true
# Validade do snapshot que semeia/reconcilia o espelho, em segundos (default 3600).
# 0 = re-tira o snapshot todo ciclo (mais conservador, mais leitura).
NESTLE_OFERTAS_SNAPSHOT_TTL_SEC=3600
NESTLE_EMBARQUES_SNAPSHOT_TTL_SEC=3600
